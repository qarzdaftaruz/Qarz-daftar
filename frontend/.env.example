# ═══════════════════════════════════════════════════════════════════════
#  Qarz Daftar — frontend .env namunasi
#  Lokal: `.env.local` deb nusxalang.
#  Vercel: Settings → Environment Variables ga qo'shing.
#  DIQQAT: VITE_ bilan boshlangan qiymatlar brauzerga tushadi —
#          hech qachon maxfiy kalit yozmang!
# ═══════════════════════════════════════════════════════════════════════

# Railway'dagi backend manzili (oxirida / BO'LMASIN)
# Vercel'da bu SHART — aks holda so'rovlar frontend domeniga ketadi.
VITE_API_URL=https://qarzdaftar-backend.up.railway.app

# ─── Faqat lokal ishlab chiqish uchun ───────────────────────────────────
# VITE_API_URL bo'sh bo'lsa, /api so'rovlari shu manzilga proxy qilinadi
VITE_DEV_API_TARGET=http://localhost:8000

# ngrok kabi tunnel domenlari (vergul bilan). Bo'sh bo'lsa hammasi ruxsat.
VITE_ALLOWED_HOSTS=
