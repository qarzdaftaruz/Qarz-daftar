# ═══════════════════════════════════════════════════════════════════════
#  Qarz Daftar — backend .env namunasi
#  Lokal: bu faylni `.env` deb nusxalang.
#  Railway: har bir qatorni "Variables" bo'limiga qo'shing (fayl yuklamang).
# ═══════════════════════════════════════════════════════════════════════

# development | production
ENVIRONMENT=development

# ─── MongoDB Atlas ──────────────────────────────────────────────────────
# Atlas: Database → Connect → Drivers → Python
# Parolda maxsus belgilar bo'lsa URL-encode qiling (@ → %40)
MONGODB_URL=mongodb+srv://user:parol@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=qarzdaftar
MONGO_MAX_POOL_SIZE=20

# ─── JWT ────────────────────────────────────────────────────────────────
# Generatsiya: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
TMA_TOKEN_EXPIRE_MINUTES=720

# ─── Telegram ───────────────────────────────────────────────────────────
BOT_TOKEN=
# Railway'da bo'sh qoldiring — RAILWAY_PUBLIC_DOMAIN dan avtomatik olinadi.
# Lokalda polling ishlaydi (bo'sh qoldiring).
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Bo'sh qoldirsangiz avtomatik generatsiya qilinadi.
# Railway'da qayta deploy'da o'zgarmasligi uchun aniq qiymat qo'yish tavsiya etiladi.
TELEGRAM_WEBHOOK_SECRET=
TMA_INITDATA_MAX_AGE=3600

# ─── Frontend (Vercel) ──────────────────────────────────────────────────
MINI_APP_URL=https://qarzdaftar.vercel.app
# CORS uchun ruxsat etilgan originlar (vergul bilan). Bo'sh bo'lsa MINI_APP_URL.
CORS_ORIGINS=https://qarzdaftar.vercel.app,https://www.qarzdaftar.uz
# Host header himoyasi (vergul bilan). Bo'sh bo'lsa Railway domeni ishlatiladi.
ALLOWED_HOSTS=

# ─── Admin ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Bo'sh qoldirsangiz birinchi ishga tushishda tasodifiy parol generatsiya
# qilinadi va Railway loglarida BIR MARTA ko'rsatiladi.
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

SUPER_ADMIN_IDS=
SUPER_ADMIN_USERNAME=Superadmin
SUPER_ADMIN_PASSWORD=
MIN_PASSWORD_LENGTH=8

# ─── Server ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
# Railway PORT ni o'zi beradi — bu qiymat faqat lokal uchun
APP_PORT=8000
MAX_BODY_SIZE=1000000

# ─── Rate limit ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
API_RATE_LIMIT=120
API_RATE_WINDOW=60
# Ilova oldida nechta ISHONCHLI proksi turadi.
#   Railway              → 1
#   Cloudflare + Railway → 2
# MUHIM: bu son noto'g'ri bo'lsa, mijoz o'zi yozgan soxta
# `X-Forwarded-For` qabul qilinib, IP bo'yicha barcha cheklovlar
# (login brute-force himoyasi ham) chetlab o'tiladi.
TRUSTED_PROXY_HOPS=1

# ─── Scheduler ──────────────────────────────────────────────────────────
TIMEZONE=Asia/Tashkent
REMINDER_HOUR=9
REMINDER_MINUTE=0

# ─── Biznes qoidalari ───────────────────────────────────────────────────
TRIAL_DAYS=7
PROMO_EXTRA_DAYS=30
ARCHIVE_DURATION_MONTHS=6
# O'chirilgan do'kon necha kun "chiqindi qutisi"da turadi (keyin butunlay o'chadi)
SHOP_PURGE_DAYS=30
# Audit yozuvlari necha kun saqlanadi
AUDIT_RETENTION_DAYS=180

# ─── Obuna nazorati ─────────────────────────────────────────────────────
# Muddati tugagan do'kon avtomatik to'xtatiladi.
# DIQQAT: false qilinsa, trial tugagach ham tizimdan bepul foydalanish mumkin.
SUBSCRIPTION_ENFORCE=true
# Muddat tugagach necha kun imtiyoz beriladi (0 = darhol to'xtaydi)
SUBSCRIPTION_GRACE_DAYS=0

# ─── Hisobotlar va eslatmalar ───────────────────────────────────────────
# Har oyning 1-sanasida do'kondorlarga Excel hisobot yuborish
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_HOUR=10
# Qarzdorga "bugun/ertaga muddat tugaydi" eslatmasi (muddatdan oldin, bir marta)
DUE_REMINDER_ENABLED=true
DUE_REMINDER_HOUR=10

# Qarzdorga "muddat o'tdi" eslatmasi — HAR KUNI, qarz to'lanmaguncha
OVERDUE_REMINDER_ENABLED=true
OVERDUE_REMINDER_HOUR=9
OVERDUE_REMINDER_MINUTE=30
# Muddat o'tganiga shuncha kundan oshsa eslatma to'xtaydi (0 = cheksiz).
# Umidsiz qarz bo'yicha yillab xabar yuborish botni bloklashga olib keladi.
OVERDUE_REMINDER_MAX_DAYS=60
# Do'kondor bitta mijozga qo'lda eslatmani necha soatda bir yubora oladi
MANUAL_REMINDER_COOLDOWN_HOURS=6
# Do'kondor kuniga necha marta Excel hisobot ola oladi
EXPORT_DAILY_LIMIT=5
# Bitta hisobotdagi maksimal qarzlar soni (xotira himoyasi)
EXPORT_MAX_ROWS=20000
# Ommaviy yuborishda xabarlar orasidagi tanaffus, soniya
BULK_SEND_DELAY=0.5

# ─── Dev ────────────────────────────────────────────────────────────────
# DIQQAT: true bo'lsa initData imzosi TEKSHIRILMAYDI.
# Production'da avtomatik o'chiriladi, lekin baribir false qoldiring.
TMA_DEV_MODE=false
